# ---------------------------------------------------------------------------
# Tienda PY — variables de entorno
# Copiá este archivo a .env.local (ignorado por git) y completá los valores.
# NINGUNA variable de acá lleva prefijo NEXT_PUBLIC_: todo esto es del servidor.
# ---------------------------------------------------------------------------

# MySQL. En Hostinger: hPanel → Bases de datos MySQL, y habilitá "Remote MySQL"
# para tu IP de desarrollo o vas a comer ECONNREFUSED desde local.
# Local (docker compose up -d):
DATABASE_URL="mysql://tienda:tienda@127.0.0.1:3306/tienda_py"

# Base separada para los tests: el runner la BORRA y la recrea en cada corrida,
# por eso el nombre tiene que contener "test". Dejala vacía y los tests de
# integración se saltan solos.
TEST_DATABASE_URL="mysql://tienda:tienda@127.0.0.1:3306/tienda_py_test"

# Cookie de sesión del admin (iron-session). Mínimo 32 caracteres.
#   openssl rand -base64 32
SESSION_PASSWORD=""

# Cuenta del dueño para `pnpm create-owner` (opcional: si no están, las pregunta).
OWNER_EMAIL=""
OWNER_PASSWORD=""
OWNER_NAME=""

# Cloudinary. `productos/` es público; `comprobantes/` va privado/authenticated
# y se sirve sólo con URLs firmadas (PR #1.10).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Datos del comercio (se usan a partir del PR #3)
COMERCIO_WHATSAPP="+595981123456"
COMERCIO_BANCO=""
COMERCIO_TITULAR=""
COMERCIO_RUC=""
COMERCIO_CUENTA=""

# Cron protegido de Hostinger (vencer pedidos, GC de reservas) — PR #4
CRON_SECRET=""

# Pagopar — recién en el PR #5, post-lanzamiento
PAGOPAR_PUBLIC_KEY=""
PAGOPAR_PRIVATE_KEY=""
