# Copy to .env.local for local dev. NEVER commit the real file.
# On Windows: use `Set-Content -Encoding utf8`, never `>` redirect
# (PowerShell writes UTF-16 by default and dotenv parsers silently fail on it).

# --- Database (Hostinger MySQL) ---
# From your machine: use the Remote MySQL hostname/IP shown in
# hPanel > Databases > Remote MySQL (e.g. srv1724.hstgr.io), port 3306.
# From the deployed app (set in hPanel env vars instead of here): use
# `localhost` — same database, different address depending on where
# the connection originates from.
DATABASE_URL="mysql://user:password@host:3306/dbname"

# --- Session / auth ---
# 32+ random bytes. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Cron ---
# Random token; Hostinger cron job hits a route with ?secret=<this> or an Authorization header.
CRON_SECRET=""

# --- WhatsApp (store number, PY format) ---
STORE_WHATSAPP_NUMBER="+5959XXXXXXXX"

# --- Pagopar (PR #5 only — not used in MVP) ---
# PAGOPAR_PUBLIC_KEY=""
# PAGOPAR_PRIVATE_KEY=""
